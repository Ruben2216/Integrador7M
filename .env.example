# ==============================================================================
# Plantilla de Configuración - Sistema Inteligente de Recomendación
# ==============================================================================
# Copia este archivo como .env y coloca tu API Key de Google AI Studio:
# cp .env.example .env

# Clave de Google AI Studio (obtén tu clave en https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelos en orden de preferencia (separados por coma)
GEMINI_MODELO=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Tiempo máximo de espera en segundos para la solicitud a Gemini
GEMINI_TIMEOUT=20

# Activa el Plan B local (1 = desactivar Gemini y usar solo rúbrica local; 0 = permitir Gemini)
GEMINI_DESACTIVADO=0

